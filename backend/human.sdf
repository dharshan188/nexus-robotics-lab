<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="human">
    <pose>2 0 0.9 0 0 0</pose>

    <link name="body">

      <!-- VISUAL -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
        </material>
      </visual>

      <!-- COLLISION -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- INERTIAL (VERY IMPORTANT) -->
      <inertial>
        <mass>20</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>